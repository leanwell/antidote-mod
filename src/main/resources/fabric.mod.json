{
	"schemaVersion": 1,
	"id": "antidote",
	"version": "${version}",
	"name": "Antidote",
	"description": "An addon for the Disabilities mod by OddSense. Introduces 30 condition-specific craftable antidotes and a God Antidote to cure all active conditions and reset the timer. Notice: This mod requires the Disabilities mod to function.",
	"authors": [
		"Leanwell"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/disabilities",
		"sources": "https://github.com/leanwell/antidote-mod",
		"issues": "https://github.com/leanwell/antidote-mod/issues"
	},
	"license": "GPL-3.0",
	"icon": "assets/antidote/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.leanwell.antidote.Antidote"
		],
		"client": [
			"com.leanwell.antidote.client.AntidoteClient"
		]
	},
	"mixins": [
		"antidote.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"disabilities": ">=0.5.0"
	}
}
